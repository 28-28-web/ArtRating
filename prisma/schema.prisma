generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String? // null for Google-OAuth-only accounts (see auth.ts)
  role                  String                 @default("user")
  createdAt             DateTime               @default(now())
  generations           Generation[]
  credit                UserCredit?
  creditPurchaseRequests CreditPurchaseRequest[]
  paddlePurchases       PaddlePurchase[]
}

model AnonymousUsage {
  id        String   @id // signed random id stored in an httpOnly cookie
  count     Int      @default(0)
  createdAt DateTime @default(now())
}

model Generation {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  anonId        String? // set when userId is null, links back to AnonymousUsage
  toolId        String // 'art-style' | 'headshot' | 'pet-to-human' | 'toy-ification' | 'photo-mix'
  usedCredit    Boolean   @default(false)
  status        String    @default("pending")
  imageUrl      String? // watermarked preview, shown on screen before payment
  cleanImageUrl String? // watermark-free file, only ever returned by /api/download.
  // Only ever set for generations made while logged in (userId != null) — see
  // the "option (b)" note in the download route: anonymous-era generations
  // aren't retroactively downloadable after logging in, so there's no clean
  // file to store for them and this column stays null.
  downloadedAt  DateTime? // set once the download credit has been charged, so a
  // page refresh / repeat click doesn't charge a second credit for the same file.
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([anonId])
}

model UserCredit {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Automated Paddle purchases — separate from CreditPurchaseRequest (the
// manual bKash/Nagad review flow, kept in place but no longer surfaced in
// the UI now that Paddle handles USD checkout). Unique on paddleOrderId so
// a retried webhook delivery for the same transaction is a no-op instead of
// double-crediting — see processPaddlePurchase in app/lib/paddlePurchases.ts.
model PaddlePurchase {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  paddleOrderId String   @unique
  priceId       String
  creditsAdded  Int
  amountPaidCents Int?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model CreditPurchaseRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  method        String // 'bkash' | 'nagad'
  transactionRef String
  credits       Int
  status        String    @default("pending") // 'pending' | 'approved' | 'rejected'
  adminNote     String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  @@index([userId])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  category  String // 'general' | 'bug' | 'misuse-report' | 'business'
  message   String   @db.Text
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)

  @@index([resolved])
}

// Daily free-generation cap for logged-in headshot users only — headshot
// moved to flux-2-dev (see cloudflareHeadshotFlux.ts), which costs real
// Neurons per call, unlike the $0/step SD1.5 model it replaces. "Unlimited for
// logged-in" (the generic generationGate.ts behavior) is unsafe for this one
// tool, so it gets its own additional daily cap, same pattern as
// PhotoMixDailyUsage below. Anonymous headshot generation is untouched —
// still governed solely by the shared 2-total AnonymousUsage cap.
model HeadshotDailyUsage {
  userId    String
  usageDate String // "YYYY-MM-DD" UTC — matches Cloudflare's 00:00 UTC Neuron reset
  count     Int    @default(0)

  @@id([userId, usageDate])
}

// IP + fingerprint based free-generation tracking — layered on top of the
// cookie-based AnonymousUsage cap so browser-storage clearing can't reset
// the counter. fingerprintHash is a lightweight client-side UA+screen hash.
model FreeGenerationLog {
  id              String   @id @default(cuid())
  ipAddress       String
  fingerprintHash String
  count           Int      @default(0)
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @updatedAt

  @@unique([ipAddress, fingerprintHash])
  @@index([ipAddress])
}

// Secondary IP-only rate limit (ignores fingerprint) to catch spoofing.
// Resets daily at 00:00 UTC, same convention as HeadshotDailyUsage.
model IpDailyUsage {
  ipAddress String
  usageDate String  // "YYYY-MM-DD" UTC
  count     Int     @default(0)

  @@id([ipAddress, usageDate])
}

// Cloudflare Neuron budget safety counter — prevents runaway free-tier cost.
// One row per UTC day; incremented after each successful free generation.
model DailyNeuronUsage {
  usageDate   String @id // "YYYY-MM-DD" UTC
  neuronCount Int    @default(0)
}
